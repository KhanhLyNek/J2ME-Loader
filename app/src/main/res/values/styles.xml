<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="buttonStyle">@style/ButtonStyle</item>
        <item name="bg_config_card">@drawable/bg_config_card</item>
        <item name="textColorPrimary">@color/text_primary</item>
        <item name="textColorSecondary">@color/text_secondary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- Scope modern theme to management activities. Do NOT remove the
         AppCompat ActionBar: menu providers rely on it. -->
    <style name="AppTheme.ManagedUi" parent="AppTheme">
        <item name="colorPrimary">@color/ui_toolbar</item>
        <item name="colorPrimaryDark">@color/ui_status</item>
        <item name="colorAccent">@color/ui_accent</item>
        <item name="colorControlActivated">@color/ui_accent</item>
        <item name="android:colorBackground">@color/ui_bg_solid</item>
        <item name="android:windowBackground">@drawable/ui_background_gradient</item>
        <item name="android:statusBarColor">@color/ui_status</item>
        <item name="android:navigationBarColor">@color/ui_status</item>
        <item name="alertDialogTheme">@style/UiAlertDialogTheme</item>
        <item name="buttonStyle">@style/ButtonStyle</item>
    </style>
    <style name="UiAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/ui_accent</item>
        <item name="android:windowBackground">@drawable/ui_dialog_background</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="actionOverflowMenuStyle">@style/Widget.AppTheme.OverflowMenu</item>
        <item name="textAppearancePopupMenuHeader">@style/PopupMenuTextAppearanceHeader</item>
        <item name="textAppearanceSmallPopupMenu">@style/PopupMenuTextAppearanceSmall</item>
        <item name="textAppearanceLargePopupMenu">@style/PopupMenuTextAppearanceLarge</item>
    </style>

    <style name="Widget.AppTheme.OverflowMenu" parent="Widget.AppCompat.Light.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/background</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="PopupMenuTextAppearanceHeader" parent="TextAppearance.AppCompat.Widget.PopupMenu.Header">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PopupMenuTextAppearanceSmall" parent="TextAppearance.AppCompat.Widget.PopupMenu.Small">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PopupMenuTextAppearanceLarge" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="FilePickerTheme" parent="Theme.AppCompat.DayNight.DialogWhenLarge">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/file_picker_accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="nnf_toolbarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="alertDialogTheme">@style/FilePickerAlertDialogTheme</item>
        <item name="nnf_separator_color">@color/nnf_separator_color</item>
        <item name="nnf_save_icon_color">?attr/colorAccent</item>
        <item name="nnf_dir_icon_color">?attr/colorAccent</item>

        <!-- These are important. Handled by toolbar. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="FilePickerAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/file_picker_accent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="ConfigTitleTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="SwitchStyle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?textColorSecondary</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHint">@color/ui_hint</item>
        <item name="android:background">@drawable/ui_input_background</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
    </style>

    <style name="ButtonStyle" parent="Widget.AppCompat.Button.Colored">
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">@color/ui_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:elevation" >1dp</item>
        <item name="android:background">@drawable/ui_button_background</item>
    </style>

    <style name="ImageButtonStyle" parent="Widget.AppCompat.ImageButton">
        <item name="android:minHeight">38dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:tint">?colorAccent</item>
    </style>

    <style name="TextViewVendor" parent="Widget.AppCompat.TextView" >
    </style>

</resources>
