<?xml version="1.0" encoding="utf-8"?>
<ru.playsoftware.j2meloader.applist.AppItemLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/ui_glass_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="17dp"
    android:paddingEnd="10dp"
    android:paddingBottom="17dp"
    android:focusable="true"
    tools:showIn="@layout/fragment_apps_list">

    <ImageView
        android:id="@+id/list_image"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/ui_icon_back"
        android:padding="10dp"
        android:scaleType="fitCenter"
        tools:src="@mipmap/ic_launcher"/>

    <TextView
        android:id="@+id/list_title"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/ui_text"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Retro Adventure"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/ui_tap_to_play"
        android:textColor="@color/ui_accent2"
        android:textSize="10sp"/>
</ru.playsoftware.j2meloader.applist.AppItemLayout>