<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ui_background_gradient">

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="-125dp"
        android:layout_marginTop="-150dp"
        android:background="@drawable/ui_ambient_orb"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/ui_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="23dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="@string/ui_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/ui_accent2"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ui_library_title"
                android:textColor="@color/ui_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ui_library_caption"
                android:textColor="@color/ui_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/ui_hero_card"
                android:gravity="center_vertical"
                android:minHeight="91dp"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="15dp"
                android:paddingEnd="18dp"
                android:paddingBottom="15dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ui_icon_back"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ui_icon_sparkles" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ui_games_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="0"
                        android:textColor="@color/ui_text"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.09"
                        android:text="@string/ui_installed"
                        android:textColor="@color/ui_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ui_icon_play" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ui_collection_title"
                android:textColor="@color/ui_text"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@android:id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="104dp"
                android:scrollbars="none"
                tools:itemCount="8"
                tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                tools:listitem="@layout/list_row_grid_jar"
                tools:spanCount="2" />

            <TextView
                android:id="@android:id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="30dp"
                android:text="@string/no_data_for_display"
                android:textColor="@color/ui_muted"
                android:textSize="15sp"
                tools:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Keep the original FAB type: AppsListFragment uses its click listener. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floating_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="23dp"
        android:layout_marginBottom="24dp"
        android:contentDescription="@string/ui_add_game"
        app:backgroundTint="@color/ui_button"
        app:rippleColor="@color/ui_accent2"
        app:srcCompat="@drawable/ic_add_white"
        app:tint="@color/ui_button_text" />
</FrameLayout>