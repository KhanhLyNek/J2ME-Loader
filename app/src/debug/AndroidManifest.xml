<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The full-emulator debug builds must retain each MIDlet Activity's
         android:process declaration from src/main. Otherwise the game runs
         in the library process, and its foreground service cannot manage
         the same MIDlet state. The standalone midlet flavor overrides this
         in src/midlet/AndroidManifest.xml instead. -->
    <application tools:ignore="GoogleAppIndexingWarning,MissingApplicationIcon" />

</manifest>
